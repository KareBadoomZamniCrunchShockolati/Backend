# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=challenge_app
DB_SSL_MODE=disable

# Redis
REDIS_ADDR=redis
REDIS_PORT=6379
REDIS_PASS=
REDIS_DB=0

# JWT
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ISSUER=challenge-app
JWT_EXPIRY_HOURS=24

# Email
EMAIL_FROM=noreply@yourapp.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# App
APP_MODE=production
APP_PORT=8080